[paths]
inbox = "~/Documents/embly/inbox"
root  = "~/Documents/embly"

[naming]
template = "{date}_{category}_{slug}"

[ocr]
engine = "paddle"
langs  = ["uz", "ru", "en"]
min_mean_confidence = 0.80
max_pdf_ocr_pages   = 50
rasterize_dpi       = 300

[classify]
model             = "convaiinnovations/laya"
subfolder         = "multilingual"   # "" = english root checkpoint
router_default    = "multilingual"   # english | multilingual | typed-decisions
router_preload    = ["english", "multilingual"]
device            = "auto"           # auto | cpu | cuda | mps
max_len           = 8192
shortlist_k       = 12
shortlist_threshold = 16
assign_confidence = 0.70
review_confidence = 0.45
max_text_tokens   = 3000
batch_size        = 32

[novelty]
cosine         = 0.55
cluster_cosine = 0.75

[naming_llm]
mode  = "llm"
model = "qwen3:4b"
host  = "http://127.0.0.1:11434"

[media]
whisper_model        = "small"   # tiny | base | small | medium | large-v3 ...
whisper_device       = "cpu"
whisper_compute_type = "int8"    # int8 | float16 | float32 ...
ffmpeg               = "ffmpeg"

[dedupe]
on_duplicate = "skip"
